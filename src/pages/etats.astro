---
<Base titre="États du tableau">
  <h1 class="visually-hidden">États du tableau</h1>
  <Departs prix="22.–" plats={[
    { date: '2026-10-27', plat: 'Trois plats seulement cette semaine' },
    { date: '2026-10-29', plat: long },
    { date: '2026-10-30', plat: 'Tartiflette' },
    { date: '2026-10-28', plat: '   ' },
  ]} />
  <Departs prix="22.–" plats={[]} />
</Base>
